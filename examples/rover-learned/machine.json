{
  "ossilic": "1",
  "name": "rover_learned",
  "version": "1.0.1",
  "description": "The reference rover with a learned brain: a small neural policy cloned from the goto + avoid brain and refined by Adapt in randomized worlds.",
  "license": "Apache-2.0",
  "authors": [
    "Ossilic"
  ],
  "body": {
    "base": {
      "type": "differential_drive",
      "wheelBase": 0.3,
      "wheelRadius": 0.05,
      "maxWheelSpeed": 14,
      "body": "chassis",
      "left": "left",
      "right": "right"
    },
    "sensors": [
      {
        "id": "lidar",
        "type": "lidar2d",
        "rays": 24,
        "fov": 3.14159,
        "range": 4,
        "height": 0.1
      },
      {
        "id": "odom",
        "type": "odometry"
      }
    ],
    "actuators": [
      {
        "id": "wheels",
        "type": "differential_drive"
      }
    ],
    "model": "rover.xml"
  },
  "brain": {
    "tickHz": 20,
    "nodes": [
      {
        "id": "lidar",
        "skill": "sensor.read",
        "params": {
          "sensor": "lidar"
        }
      },
      {
        "id": "odom",
        "skill": "sensor.read",
        "params": {
          "sensor": "odom"
        }
      },
      {
        "id": "observe",
        "skill": "nav.observe",
        "params": {
          "x": 5,
          "y": 5
        }
      },
      {
        "id": "policy",
        "skill": "brain.policy",
        "params": {
          "file": "brains/navigate.mlp.json"
        }
      },
      {
        "id": "act",
        "skill": "act.twist"
      },
      {
        "id": "wheels",
        "skill": "actuator.write",
        "params": {
          "actuator": "wheels"
        }
      }
    ],
    "edges": [
      {
        "from": "lidar.value",
        "to": "observe.scan"
      },
      {
        "from": "odom.value",
        "to": "observe.pose"
      },
      {
        "from": "observe.obs",
        "to": "policy.obs"
      },
      {
        "from": "policy.action",
        "to": "act.action"
      },
      {
        "from": "act.twist",
        "to": "wheels.command"
      }
    ],
    "done": "observe.reached"
  },
  "deploy": {
    "targets": [
      {
        "name": "sim",
        "driver": "sim2d",
        "config": {
          "bounds": {
            "w": 6,
            "h": 6
          },
          "start": {
            "x": 0.5,
            "y": 0.5,
            "theta": 0
          },
          "obstacles": [
            {
              "x": 2,
              "y": 2,
              "r": 0.45
            },
            {
              "x": 3.5,
              "y": 3,
              "r": 0.5
            },
            {
              "x": 2.8,
              "y": 4.3,
              "r": 0.4
            },
            {
              "x": 4.5,
              "y": 4.4,
              "r": 0.35
            }
          ],
          "lidarNoise": 0.02,
          "seed": 1
        }
      },
      {
        "name": "physics",
        "driver": "mujoco",
        "config": {
          "seed": 1,
          "lidarNoise": 0.02
        }
      },
      {
        "name": "edge",
        "driver": "ros2",
        "config": {
          "namespace": "/rover"
        }
      }
    ]
  }
}
